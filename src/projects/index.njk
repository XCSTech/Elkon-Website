---
nav_prefix: "../"
page_title: "All Projects"
---
<!DOCTYPE html>
<html lang="en-CA">
<head>
{% include "head.njk" %}
</head>
<body>
{% import "icons.njk" as icon %}
{% include "nav.njk" %}

  <main id="main">
  <section class="section section-light page-wrap">
    <div class="container">
      <header class="page-head">
        <p class="section-label">{{ projects.eyebrow }}</p>
        <h1 class="section-title">All projects</h1>
        <p class="section-sub">{{ projects.sub }}</p>
      </header>

      <div class="section-cards project-grid">
        {% for p in projects.items %}<article class="project-card project-card-static">
          <div class="project-card-image">
            <img src="../{{ p.img }}" alt="{{ p.title }}" loading="lazy" width="900" height="600">
            <span class="img-tag mono">{{ p.badge }}</span>
          </div>
          <div class="project-card-body">
            <h2 class="h3-like">{{ p.title }}</h2>
            <span class="project-loc mono">{{ p.loc }}</span>
            <p>{{ p.teaser }}</p>
          </div>
        </article>
        {% endfor %}</div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="container cta-band-inner">
      <h2 class="section-title">Working on something<br>like this?</h2>
      <div class="hero-ctas">
        <a class="btn btn-orange" href="../{{ nav.cta_href }}">{{ nav.cta_label }} {{ icon.arrow() | safe }}</a>
        {% if site.contact.phone_display %}<a class="btn btn-ghost" href="tel:{{ site.contact.phone_link }}">{{ icon.phone() | safe }}{{ site.contact.phone_display }}</a>{% endif %}
      </div>
    </div>
  </section>
  </main>

{% include "footer.njk" %}

  <script src="../js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
