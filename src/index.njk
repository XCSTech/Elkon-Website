<!DOCTYPE html>
<html lang="en-CA">
<head>
{% include "head.njk" %}
</head>
<body>
{% import "icons.njk" as icon %}
{% include "nav.njk" %}

  <main id="main">

  <!-- ===== HERO ===== -->
  <section class="hero" id="hero">
    <div class="hero-media">
      <img src="{{ hero.image }}" alt="" width="2000" height="1333" fetchpriority="high">
    </div>

    <div class="container hero-content">
      <p class="hero-kicker" data-reveal>
        {% for k in hero.kicker %}<span>{{ k }}</span>{% endfor %}
      </p>
      <h1 class="display" data-split>{{ hero.heading | highlight(hero.highlight) | nl2br | safe }}</h1>
      <p class="hero-sub" data-reveal style="--delay:250ms">{{ hero.sub }}</p>

      <div class="hero-ctas" data-reveal style="--delay:350ms">
        <a href="{{ hero.primary_cta.href }}" class="btn btn-orange">{{ hero.primary_cta.label }} {{ icon.arrow() | safe }}</a>
        {% if site.contact.phone_display %}
        <a href="tel:{{ site.contact.phone_link }}" class="btn btn-ghost" aria-label="Call {{ site.contact.phone_display }}">{{ icon.phone() | safe }}{{ site.contact.phone_display }}</a>
        {% else %}
        <a href="{{ hero.secondary_cta.href }}" class="btn btn-ghost">{{ hero.secondary_cta.label }}</a>
        {% endif %}
      </div>

      <dl class="hero-spec mono" data-reveal style="--delay:450ms">
        {% for s in hero.specs %}<div><dt>{{ s.label }}</dt><dd><b>{{ s.value }}</b></dd></div>
        {% endfor %}</dl>
    </div>
  </section>

  <!-- ===== PRODUCTS ===== -->
  <section class="section section-light" id="products">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ products.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title" data-split>{{ products.heading | nl2br | safe }}</h2>
        <p class="section-sub" data-reveal>{{ products.sub }}</p>

        <div class="section-cards product-grid">
          {% for product in products.items %}<article class="product-card">
            <div class="product-card-image">
              <img src="{{ product.image }}" alt="{{ product.image_alt }}" width="900" height="600" loading="lazy" decoding="async">
              <span class="img-tag mono">{{ product.badge }}</span>
            </div>
            <div class="product-card-body">
              <h3>{{ product.name }}</h3>
              <span class="product-type mono">{{ product.type }}</span>
              <p>{{ product.description }}</p>
              <ul class="spec-rows">
                {% for s in product.specs %}<li>{{ s.label }} <b>{{ s.value }}</b></li>
                {% endfor %}</ul>
              <a href="#contact" class="card-cta" data-product="{{ product.form_value }}">{{ product.cta_label }} {{ icon.arrow() | safe }}</a>
            </div>
          </article>
          {% endfor %}</div>
      </div>
    </div>
  </section>

  <!-- ===== MARKETS ===== -->
  <section class="section section-dark" id="markets">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ markets.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title" data-split>{{ markets.heading | nl2br | safe }}</h2>
        <p class="section-sub" data-reveal>{{ markets.sub }}</p>

        <div class="section-cards market-list">
          {% for panel in markets.panels %}<article class="market-panel">
            <div class="market-image-wrap">
              <img class="market-image" src="{{ panel.image }}" alt="{{ panel.image_alt }}" width="1600" height="900" loading="lazy" decoding="async">
            </div>
            <div class="market-body">
              <span class="market-number">{{ panel.number }}</span>
              <h3>{{ panel.heading }}</h3>
              <p>{{ panel.description }}</p>
            </div>
          </article>
          {% endfor %}</div>
      </div>
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section class="section section-light" id="projects">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ projects.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title" data-split>{{ projects.heading | nl2br | safe }}</h2>
        <p class="section-sub" data-reveal>{{ projects.sub }}</p>

        <div class="section-cards project-grid"></div>
        <noscript><ul>{% for proj in projects.items %}<li>{{ proj.title }}, {{ proj.loc }}</li>{% endfor %}</ul></noscript>

        <p class="projects-more">
          <a href="projects/" class="btn btn-ink">{{ projects.view_all_cta }} {{ icon.arrow() | safe }}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== COVERAGE (stats + map) ===== -->
  <section class="section section-dark" id="coverage">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ stats.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title proof-title" data-split>{{ stats.heading | nl2br | safe }}</h2>

        {% set years = stats.cards.years.founded_year | yearsSince %}
        <div class="stats-row">
          <div class="stat">
            <div class="stat-number"><span data-count="{{ years }}">{{ years }}</span><span class="suffix">{{ stats.cards.years.suffix }}</span></div>
            <div class="stat-label mono">{{ stats.cards.years.label }}</div>
            <p class="stat-blurb">{{ stats.cards.years.blurb }}</p>
          </div>
          <div class="stat">
            <div class="stat-number"><span class="suffix">{{ stats.cards.rank.prefix }}</span>{{ stats.cards.rank.target }}</div>
            <div class="stat-label mono">{{ stats.cards.rank.label }}</div>
          </div>
          <div class="stat">
            <div class="stat-number"><span data-count="{{ stats.cards.regions.target }}">{{ stats.cards.regions.target }}</span></div>
            <div class="stat-label mono">{{ stats.cards.regions.label }}</div>
          </div>
        </div>

{% include "coverage-map.njk" %}
      </div>
    </div>
  </section>

  <!-- ===== DOSAGE CALCULATOR ===== -->
  <section class="section section-light" id="calculator">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ calculator.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title" data-split>{{ calculator.heading | nl2br | safe }}</h2>
        <p class="section-sub" data-reveal>{{ calculator.sub }}</p>

        <div class="calc-card">
          <div class="calc-grid">
            <div class="calc-form-side">
              <h3 class="calc-side-heading mono">{{ calculator.form_heading }}</h3>
              <div class="form-group">
                <label for="application">Application</label>
                <select id="application">
                  <option value="general">General HPC (5–8%)</option>
                  <option value="marine">Marine / coastal (8–10%)</option>
                  <option value="bridge">Bridge deck / highway (7–9%)</option>
                  <option value="shotcrete">Shotcrete (8–12%)</option>
                  <option value="uhpc">Ultra-high performance (15–25%)</option>
                  <option value="oilwell">Oil well cementing (10–15%)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="volume">Concrete / cement volume (m³)</label>
                <input type="number" id="volume" inputmode="decimal" placeholder="e.g. 500" min="1">
              </div>
              <div class="form-group">
                <label for="cement">Cement content (kg/m³)</label>
                <input type="number" id="cement" inputmode="decimal" placeholder="e.g. 400" min="100" value="400">
              </div>
              <div class="calc-actions">
                <button type="button" class="btn btn-ink" id="calcBtn">{{ calculator.cta_label }}</button>
                <a href="#contact" class="btn btn-orange" id="calcQuoteBtn" hidden>{{ calculator.quote_cta_label }} {{ icon.arrow() | safe }}</a>
              </div>
            </div>

            <div class="calc-result-side" id="calcResult" aria-live="polite">
              <h3 class="calc-side-heading mono">{{ calculator.result_heading }}</h3>
              <div class="result-row"><span class="result-label mono">{{ calculator.result_labels.dosage }}</span><span class="result-value" id="dosageRate">&mdash;<span class="unit">%</span></span></div>
              <div class="result-row"><span class="result-label mono">{{ calculator.result_labels.total }}</span><span class="result-value highlight" id="totalKg">&mdash;<span class="unit">kg</span></span></div>
              <div class="result-row"><span class="result-label mono">{{ calculator.result_labels.sacks }}</span><span class="result-value" id="sacks">&mdash;</span></div>
              <div class="result-row"><span class="result-label mono">{{ calculator.result_labels.tonnes }}</span><span class="result-value" id="tonnes">&mdash;<span class="unit">t</span></span></div>
              <p class="calc-note mono">{{ calculator.note }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="section section-dark" id="contact">
    <div class="container section-split">
      <div class="section-eyebrow"><div class="section-label">{{ contact.eyebrow }}</div></div>

      <div class="section-content">
        <h2 class="section-title" data-split>{{ contact.heading | nl2br | safe }}</h2>

        <div class="contact-grid">
          <div class="contact-info">
            <h3>{{ contact.info_heading }}</h3>
            <p>{{ contact.info_blurb }}</p>

            {% if site.contact.phone_display %}
            <a class="contact-big" href="tel:{{ site.contact.phone_link }}">{{ icon.phone(1.75) | safe }}{{ site.contact.phone_display }}</a>
            <span class="mono" style="color:var(--text-inv-muted)">{{ contact.phone_subline }}</span>
            {% endif %}

            <ul class="contact-rows">
              <li><span class="mono">Email</span><span class="row-val">{{ icon.mail() | safe }}<a class="link-draw" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></span></li>
              <li><span class="mono">Delivery</span><span class="row-val">{{ icon.truck() | safe }}{{ contact.delivery_label }} {{ contact.delivery_subline | safe }}</span></li>
            </ul>
          </div>

          {% set f = contact.form.fields %}
          <form class="quote-form" id="quoteForm" data-static novalidate>
            <h3>{{ contact.form.heading }}</h3>
            <div class="form-row">
              <div class="form-group">
                <label for="quote-name">{{ f.name }}</label>
                <input type="text" id="quote-name" name="name" autocomplete="name" placeholder="{{ f.name_placeholder }}" required>
              </div>
              <div class="form-group">
                <label for="quote-company">{{ f.company }} <span class="opt">(optional)</span></label>
                <input type="text" id="quote-company" name="company" autocomplete="organization" placeholder="{{ f.company_placeholder }}">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="quote-email">{{ f.email }}</label>
                <input type="email" id="quote-email" name="email" autocomplete="email" placeholder="{{ f.email_placeholder }}" required>
              </div>
              <div class="form-group">
                <label for="quote-phone">{{ f.phone }}</label>
                <input type="tel" id="quote-phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="{{ f.phone_placeholder }}">
              </div>
            </div>

            <fieldset class="form-group">
              <legend>{{ f.product }}</legend>
              <div class="check-row">
                {% for opt in contact.form.product_options %}<label class="check"><input type="checkbox" name="product[]" value="{{ opt.value }}">{{ opt.label }}</label>
                {% endfor %}</div>
            </fieldset>

            <div class="form-row">
              <div class="form-group">
                <label for="quote-quantity">{{ f.quantity }}</label>
                <input type="text" id="quote-quantity" name="quantity" placeholder="{{ f.quantity_placeholder }}">
              </div>
              <div class="form-group">
                <label for="quote-location">{{ f.location }}</label>
                <input type="text" id="quote-location" name="location" autocomplete="address-level2" placeholder="{{ f.location_placeholder }}" required>
              </div>
            </div>
            <div class="form-group">
              <label for="quote-contact-method">{{ f.contact_method }}</label>
              <select id="quote-contact-method" name="contact_method">
                {% for opt in contact.form.contact_method_options %}<option value="{{ opt.value }}">{{ opt.label }}</option>
                {% endfor %}</select>
            </div>
            <div class="form-group">
              <label for="quote-message">{{ f.message }} <span class="opt">(optional)</span></label>
              <textarea id="quote-message" name="message" placeholder="{{ f.message_placeholder }}"></textarea>
            </div>
            <button type="submit" class="btn btn-orange btn-block">{{ contact.form.submit_label }}</button>
            <p class="form-status" id="formStatus" role="status" hidden></p>
            <p class="form-fine">We only use your details to answer this request.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  </main>

{% include "footer.njk" %}

  <!-- ===== PROJECT MODAL ===== -->
  <div class="project-modal" id="projectModal" aria-hidden="true">
    <div class="project-modal-backdrop" data-modal-close></div>
    <div class="project-modal-content" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button type="button" class="project-modal-close" data-modal-close aria-label="Close project details">{{ icon.close() | safe }}</button>
      <div id="modalBody"></div>
    </div>
  </div>

  <script type="application/json" id="projects-data">{{ projects.items | jsonScript | safe }}</script>
  <script src="js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
