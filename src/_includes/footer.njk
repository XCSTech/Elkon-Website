{% set p = nav_prefix | default('') %}
  <footer class="footer">
    <div class="footer-strip" aria-hidden="true">
      {% for proj in projects.items %}{% if loop.index <= 6 %}<img src="{{ p }}{{ proj.img }}" alt="" loading="lazy" width="600" height="600">
      {% endif %}{% endfor %}</div>
    <div class="container footer-body">
      <div class="footer-brand">
        <a href="{{ p }}#hero" class="footer-logo" aria-label="Elkon Products home"><img src="{{ p }}img/logo.jpg" alt="Elkon Products" width="324" height="194"></a>
        <p class="footer-tag">{{ footer.tagline }}</p>
        <p class="footer-copy mono">{{ site.copyright | safe }}</p>
      </div>
      <div class="footer-right">
        <div class="footer-main">
          <div class="footer-col">
            <h4 class="mono">Site</h4>
            <ul>
              {% for link in nav.links %}<li><a href="{{ p }}{{ link.href }}">{{ link.label }}</a></li>
              {% endfor %}</ul>
          </div>
          <div class="footer-col">
            <h4 class="mono">Contact</h4>
            <ul>
              {% if site.contact.phone_display %}<li><a href="tel:{{ site.contact.phone_link }}">{{ site.contact.phone_display }}</a></li>{% endif %}
              <li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
              {% if contact.office %}<li>{{ contact.office }}</li>{% endif %}
            </ul>
          </div>
          <div class="footer-col">
            <h4 class="mono">Member</h4>
            <ul>
              {% for badge in footer.badges %}<li>{{ badge }}</li>
              {% endfor %}</ul>
          </div>
        </div>
        <div class="footer-base mono">
          <span>{{ footer.base_line }}</span>
        </div>
      </div>
    </div>
  </footer>
