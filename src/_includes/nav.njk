{% import "icons.njk" as icon %}
{% set p = nav_prefix | default('') %}
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav" id="nav">
    <div class="container nav-inner">
      <a href="{{ p }}#hero" class="nav-logo" aria-label="Elkon Products home">
        <img src="{{ p }}img/logo.jpg" alt="Elkon Products" width="324" height="194">
      </a>

      <nav aria-label="Main">
        <ul class="nav-links" id="navLinks">
          {% for link in nav.links %}<li><a href="{{ p }}{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}{% if site.contact.phone_display %}<li>
            <a href="tel:{{ site.contact.phone_link }}" class="nav-phone">{{ icon.phone(1.75) | safe }} {{ site.contact.phone_display }}</a>
          </li>{% endif %}
          <li><a href="{{ p }}{{ nav.cta_href }}" class="btn btn-orange">{{ nav.cta_label }}</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        {% if site.contact.phone_display %}<a href="tel:{{ site.contact.phone_link }}" class="icon-btn call" aria-label="Call Elkon at {{ site.contact.phone_display }}">
          {{ icon.phone() | safe }}<span class="call-num">{{ site.contact.phone_display }}</span>
        </a>{% endif %}
        <button class="icon-btn nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>
